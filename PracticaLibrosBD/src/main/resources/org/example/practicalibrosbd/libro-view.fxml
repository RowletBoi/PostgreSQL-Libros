<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="527.0" prefWidth="731.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.practicalibrosbd.controller.LibroController">
   <children>
      <Label layoutX="296.0" layoutY="16.0" text="Registro de Libro">
         <font>
            <Font size="19.0" />
         </font>
      </Label>
      <GridPane layoutX="127.0" layoutY="57.0" prefHeight="168.0" prefWidth="479.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="234.89352416992188" minWidth="10.0" prefWidth="105.95480346679688" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="373.0451965332031" minWidth="10.0" prefWidth="373.0451965332031" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Titulo:" />
            <Label text="Autor" GridPane.rowIndex="1" />
            <Label text="Categoria:" GridPane.rowIndex="2" />
            <Label text="Precio:" GridPane.rowIndex="3" />
            <Label text="Stock:" GridPane.rowIndex="4" />
            <TextField fx:id="txtTitulo" promptText="Titulo del Libro" GridPane.columnIndex="1" />
            <TextField fx:id="txtAutor" promptText="Autor del Libro" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtPrecio" promptText="Precio del libro" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="txtStock" promptText="Stock del Libro" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <ComboBox fx:id="cmbCategoria" prefHeight="26.0" prefWidth="375.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>
      <Button fx:id="btnRegistrar" layoutX="324.0" layoutY="254.0" mnemonicParsing="false" onAction="#registrarLibro" text="Registrar Libro" />
      <Button fx:id="btnActualizar" layoutX="475.0" layoutY="255.0" mnemonicParsing="false" onAction="#actualizarRegistro" text="Actualizar Registro" />
      <Button fx:id="btnLimpiar" layoutX="150.0" layoutY="255.0" mnemonicParsing="false" onAction="#limpiarCampo" text="Limpiar Campos" />
      <TableView fx:id="tblLibro" layoutX="40.0" layoutY="298.0" prefHeight="200.0" prefWidth="653.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="75.0" text="Id" />
          <TableColumn fx:id="colTItulo" prefWidth="139.0" text="Titulo" />
          <TableColumn fx:id="colAutor" prefWidth="118.0" text="Autor" />
            <TableColumn fx:id="colCategoria" prefWidth="146.0" text="Categoria" />
            <TableColumn fx:id="colPrecio" prefWidth="91.0" text="Precio" />
            <TableColumn fx:id="colStock" prefWidth="75.0" text="Stock" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
